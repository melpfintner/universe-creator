# Backup de configuração do UniVerse Creator.
# Este arquivo é apenas referência; configure estas variáveis no painel do Cloudflare Workers.
# Nunca armazene SESSION_SECRET, ADMIN_PASSWORD ou tokens reais no GitHub.

# Origem exata da interface, se for diferente da URL do próprio Worker.
APP_ORIGIN=https://universe-creator-interface.universe-creator.workers.dev

# Módulo 1: endpoint Colab informado. A rota foi separada do domínio com uma barra.
COLAB_MODULE1_URL=https://8000-m-s-usc1c9-6yt3078jvtwt-c.us-central1.prod.r.colab.dev/create_identity

# Módulo 2: preencher quando o endpoint de geração de imagens estiver ativo no Colab.
COLAB_MODULE2_URL=https://SEU-ENDPOINT-COLAB/create_image

# Opcional: token Bearer compartilhado entre o Worker e o endpoint Colab.
COLAB_API_TOKEN=
